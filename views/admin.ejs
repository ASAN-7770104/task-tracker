<%- include('partials/header') %>
<%- include('partials/nav') %>

<h1>Admin</h1>

<h2>Tasks per user</h2>
<table>
  <tr>
    <th>User</th>
    <th>Tasks</th>
  </tr>
  <% counts.forEach(function (row) { %>
    <tr>
      <td><%= row.username %></td>
      <td><%= row.total %></td>
    </tr>
  <% }) %>
</table>

<h2>All tasks</h2>
<table>
  <tr>
    <th>Title</th>
    <th>Owner</th>
    <th></th>
  </tr>
  <% tasks.forEach(function (task) { %>
    <tr class="priority-<%= task.priority %>">
      <td><%= task.title %></td>
      <td><%= task.owner %></td>
      <td>
        <form action="/admin/tasks/<%= task.id %>/delete" method="POST">
          <button type="submit">Delete</button>
        </form>
      </td>
    </tr>
  <% }) %>
</table>

<h2>Last 10 lines of access.log</h2>
<% if (logLines.length === 0) { %>
  <p>No log lines yet</p>
<% } else { %>
  <pre><% logLines.forEach(function (line) { %><%= line %>
<% }) %></pre>
<% } %>

<%- include('partials/footer') %>

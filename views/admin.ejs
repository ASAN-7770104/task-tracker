<%- include('partials/header') %>
<%- include('partials/nav') %>

<h1>Admin panel</h1>

<section class="card">
  <h2>Tasks per user</h2>
  <table>
    <thead>
      <tr><th>User</th><th>Tasks</th></tr>
    </thead>
    <tbody>
      <% counts.forEach(function (c) { %>
        <tr>
          <td><%= c.username %></td>
          <td><%= c.total %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</section>

<section class="card">
  <h2>Last 10 lines of access.log</h2>
  <% if (logLines.length === 0) { %>
    <p class="empty">The log is empty.</p>
  <% } else { %>
    <pre class="log"><% logLines.forEach(function (line) { %><%= line %>
<% }); %></pre>
  <% } %>
</section>

<%- include('partials/footer') %>

<header>
  <nav>
    <strong>Task Tracker</strong>
    <% if (currentUser) { %>
      <a href="/tasks">Tasks</a>
      <% if (currentUser.role === 'admin') { %>
        <a href="/admin">Admin</a>
      <% } %>
      <span>Logged in as <%= currentUser.username %></span>
      <form action="/logout" method="POST">
        <button type="submit">Logout</button>
      </form>
    <% } else { %>
      <a href="/">Login</a>
    <% } %>
  </nav>
</header>

<%- include('partials/header') %>
<%- include('partials/nav') %>

<h1>Tasks</h1>

<p>
  Show:
  <a href="/tasks">all</a> |
  <a href="/tasks?status=open">open</a> |
  <a href="/tasks?status=done">done</a>
</p>

<% if (tasks.length === 0) { %>
  <p>No tasks yet</p>
<% } else { %>
  <table>
    <tr>
      <th>Title</th>
      <th>Priority</th>
      <th>Due</th>
      <th>Status</th>
      <th>Owner</th>
      <th></th>
    </tr>
    <% tasks.forEach(function (task) { %>
      <tr class="priority-<%= task.priority %>">
        <td><a href="/tasks/<%= task.id %>"><%= task.title %></a></td>
        <td><%= task.priority %></td>
        <td><%= task.due %></td>
        <td><%= task.status %></td>
        <td><%= task.owner %></td>
        <td>
          <% if (task.status === 'open') { %>
            <form action="/tasks/<%= task.id %>/done" method="POST">
              <button type="submit">Mark done</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </table>
<% } %>

<h2>Add task</h2>

<% if (errors.length > 0) { %>
  <ul class="error-list">
    <% errors.forEach(function (message) { %>
      <li class="error"><%= message %></li>
    <% }) %>
  </ul>
<% } %>

<form action="/tasks" method="POST">
  <label for="title">Title</label>
  <input type="text" id="title" name="title" value="<%= input.title %>">

  <label for="priority">Priority</label>
  <select id="priority" name="priority">
    <% ['low', 'medium', 'high'].forEach(function (level) { %>
      <option value="<%= level %>"<%= input.priority === level ? ' selected' : '' %>><%= level %></option>
    <% }) %>
  </select>

  <label for="due">Due date (YYYY-MM-DD)</label>
  <input type="text" id="due" name="due" value="<%= input.due %>">

  <button type="submit">Add task</button>
</form>

<%- include('partials/footer') %>
